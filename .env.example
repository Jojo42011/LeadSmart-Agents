RINGBA_API_TOKEN=your_token_here
RINGBA_ACCOUNT_ID=your_account_id_here
DRY_RUN=true
# 28800000 = 8 hours
POLL_INTERVAL_MS=28800000
CALL_DELAY_MS=500
PORT=3000
# Local: omit DATA_DIR (uses ./data). Fly: /app/data via fly.toml
# DATA_DIR=./data
RINGBA_DEBUG=false

# JARVIS brain (OpenAI)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# JARVIS voice (ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional
# BRAVE_SEARCH_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2_realtime
